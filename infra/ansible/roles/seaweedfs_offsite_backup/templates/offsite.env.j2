# systemd EnvironmentFile. 셸이 아니라 systemd가 KEY=VALUE 로만 읽는다.
# 이 파일에만 비밀이 있고 스크립트·유닛·rclone 설정 파일에는 없다.
# mode 0600 root 소유이며 서비스 계정은 이 파일을 직접 읽지 않는다.

# --- AWS 전송 자격증명 (전용 IAM user, 삭제 권한 없음) ---
AWS_ACCESS_KEY_ID={{ offsite_aws_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ offsite_aws_secret_access_key }}

# --- 착지점과 경보 ---
OFFSITE_AWS_REGION={{ offsite_aws_region }}
OFFSITE_AWS_BUCKET={{ offsite_aws_bucket }}
OFFSITE_COPY_PREFIX={{ offsite_copy_prefix }}
OFFSITE_HEARTBEAT_PREFIX={{ offsite_heartbeat_prefix }}
OFFSITE_HEARTBEAT_NAMESPACE={{ offsite_heartbeat_namespace }}
OFFSITE_HEARTBEAT_METRIC={{ offsite_heartbeat_metric }}
OFFSITE_ALERT_TOPIC_ARN={{ offsite_alert_topic_arn }}

# --- 원본 ---
OFFSITE_LOCAL_ENDPOINT={{ offsite_local_endpoint }}
OFFSITE_SOURCE_BUCKETS={{ offsite_source_buckets | join(' ') }}

# --- rclone remote 정의 ---
# 설정 파일 대신 환경변수로 둔다. 비밀의 사본을 늘리지 않기 위해서다.
RCLONE_CONFIG_AWS_TYPE=s3
RCLONE_CONFIG_AWS_PROVIDER=AWS
RCLONE_CONFIG_AWS_ENV_AUTH=true
RCLONE_CONFIG_AWS_REGION={{ offsite_aws_region }}
RCLONE_CONFIG_AWS_LOCATION_CONSTRAINT={{ offsite_aws_region }}
RCLONE_CONFIG_AWS_SERVER_SIDE_ENCRYPTION=AES256
# bucket 존재 확인과 자동 생성을 하지 않는다. 전송 identity에 CreateBucket 권한이 없다.
RCLONE_CONFIG_AWS_NO_CHECK_BUCKET=true

RCLONE_CONFIG_LOCAL_TYPE=s3
RCLONE_CONFIG_LOCAL_PROVIDER=Other
RCLONE_CONFIG_LOCAL_ENV_AUTH=false
RCLONE_CONFIG_LOCAL_ENDPOINT={{ offsite_local_endpoint }}
RCLONE_CONFIG_LOCAL_FORCE_PATH_STYLE=true
RCLONE_CONFIG_LOCAL_ACCESS_KEY_ID={{ offsite_local_access_key_id }}
RCLONE_CONFIG_LOCAL_SECRET_ACCESS_KEY={{ offsite_local_secret_access_key }}
