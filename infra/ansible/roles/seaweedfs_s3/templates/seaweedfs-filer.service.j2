[Unit]
Description=SeaweedFS filer
Documentation=https://github.com/seaweedfs/seaweedfs
After=network-online.target seaweedfs-master.service seaweedfs-volume.service
Wants=network-online.target
Requires=seaweedfs-master.service seaweedfs-volume.service

[Service]
Type=simple
User={{ seaweedfs_user }}
Group={{ seaweedfs_group }}
UMask=0027
ExecStart={{ seaweedfs_binary_path }} filer \
  -master=127.0.0.1:{{ seaweedfs_master_port }} \
  -ip=127.0.0.1 \
  -ip.bind=127.0.0.1 \
  -port={{ seaweedfs_filer_port }} \
  -port.grpc={{ seaweedfs_filer_grpc_port }} \
  -defaultStoreDir={{ seaweedfs_filer_dir }} \
  -defaultReplicaPlacement=000 \
{% if seaweedfs_metrics_enabled %}
  -metricsIp={{ seaweedfs_metrics_bind_address }} \
  -metricsPort={{ seaweedfs_filer_metrics_port }}
{% else %}
  -metricsPort=0
{% endif %}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadWritePaths={{ seaweedfs_filer_dir }}
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressAllow=localhost
{% if seaweedfs_metrics_enabled %}
IPAddressAllow={{ seaweedfs_metrics_bind_address }}/32
{% for source in seaweedfs_metrics_allowed_sources %}
IPAddressAllow={{ source }}
{% endfor %}
{% endif %}
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
