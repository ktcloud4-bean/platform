#!/bin/bash
set -euo pipefail

STATE_DIR={{ k3s_datastore_backup_state_dir }}
MAX_AGE={{ k3s_datastore_backup_health_max_age_seconds }}
SUCCESS_FILE="${STATE_DIR}/last-success.epoch"

if [ ! -r "${SUCCESS_FILE}" ]; then
  echo "마지막 성공 기록이 없다" >&2
  exit 1
fi

read -r LAST_SUCCESS <"${SUCCESS_FILE}"
case "${LAST_SUCCESS}" in
  ''|*[!0-9]*) echo "마지막 성공 시각 형식이 잘못됐다" >&2; exit 1 ;;
esac

NOW=$(date -u +%s)
AGE=$((NOW - LAST_SUCCESS))
if [ "${AGE}" -lt 0 ] || [ "${AGE}" -gt "${MAX_AGE}" ]; then
  echo "마지막 성공이 freshness 기준을 벗어났다 age=${AGE}s max=${MAX_AGE}s" >&2
  exit 1
fi

printf 'healthy age=%ss max=%ss\n' "${AGE}" "${MAX_AGE}"
