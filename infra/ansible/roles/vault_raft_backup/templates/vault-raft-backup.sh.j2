#!/bin/bash
set -euo pipefail
umask 077

STATE_DIR={{ bkp03_state_dir }}
CACHE_DIR={{ bkp03_cache_dir }}
CONFIG_DIR={{ bkp03_config_dir }}
TOKEN_FILE={{ vault_backup_token_path }}
VAULT_CA={{ vault_backup_ca_path }}
RCLONE={{ bkp03_rclone_path }}
BUCKET=${BKP03_S3_BUCKET:?BKP03_S3_BUCKET is required}
RETENTION=${BKP03_RETENTION_COUNT:?BKP03_RETENTION_COUNT is required}

exec 9>"${STATE_DIR}/backup.lock"
flock -n 9 || { echo "다른 Vault snapshot이 실행 중이다" >&2; exit 75; }

[ -r "${TOKEN_FILE}" ] || { echo "전용 Vault snapshot token이 없다" >&2; exit 78; }
[ "$(stat -c %a "${TOKEN_FILE}")" = 600 ] \
  || { echo "Vault snapshot token mode가 0600이 아니다" >&2; exit 78; }

STAGE=$(mktemp -d "${CACHE_DIR}/backup.XXXXXX")
cleanup() { rm -rf -- "${STAGE}"; }
trap cleanup EXIT INT TERM

RUN_LOG="${STATE_DIR}/last-run.log"
: >"${RUN_LOG}"
log() {
  local line
  line="$(date -u '+%Y-%m-%dT%H:%M:%SZ') $*"
  printf '%s\n' "${line}" | tee -a "${RUN_LOG}"
}

TOKEN=$(tr -d '\r\n' <"${TOKEN_FILE}")
[ -n "${TOKEN}" ] || { echo "Vault snapshot token이 비어 있다" >&2; exit 78; }
CURL_CONFIG="${STAGE}/curl.conf"
printf 'header = "X-Vault-Token: %s"\n' "${TOKEN}" >"${CURL_CONFIG}"
unset TOKEN

VAULT_URL="https://${VAULT_BACKUP_HOSTNAME}:${VAULT_BACKUP_PORT}"
CURL_COMMON=(
  --silent --show-error --fail-with-body
  --connect-timeout 5 --max-time 120
  --cacert "${VAULT_CA}"
  --resolve "${VAULT_BACKUP_HOSTNAME}:${VAULT_BACKUP_PORT}:${VAULT_BACKUP_SERVICE_IP}"
)

curl "${CURL_COMMON[@]}" "${VAULT_URL}/v1/sys/health" >"${STAGE}/health.json"
python3 - "${STAGE}/health.json" <<'PY'
import json, sys
d=json.load(open(sys.argv[1]))
if not d.get('initialized') or d.get('sealed') or d.get('standby'):
    raise SystemExit('live Vault is not an unsealed leader')
PY
log "live Vault unsealed Raft leader 확인"

curl "${CURL_COMMON[@]}" --config "${CURL_CONFIG}" --request POST \
  --data '{"increment":"48h"}' "${VAULT_URL}/v1/auth/token/renew-self" \
  >"${STAGE}/renew.json"

STAMP=$(date -u '+%Y%m%dT%H%M%SZ')
SNAPSHOT="vault-raft-${STAMP}.snap"
OBJECT="vault/${SNAPSHOT}"
MANIFEST="${SNAPSHOT}.sha256"
RCLONE_COMMON=(
  --config "${CONFIG_DIR}/rclone.conf"
  --ca-cert "{{ bkp03_s3_ca_path }}"
  --retries 3
  --low-level-retries 10
  --log-level NOTICE
)

if "${RCLONE}" lsf "local:${BUCKET}/${OBJECT}" "${RCLONE_COMMON[@]}" 2>/dev/null | grep -q .; then
  log "동일 object가 이미 있어 덮어쓰지 않는다 object=${OBJECT}"
  exit 75
fi

curl "${CURL_COMMON[@]}" --config "${CURL_CONFIG}" \
  "${VAULT_URL}/v1/sys/storage/raft/snapshot" >"${STAGE}/${SNAPSHOT}"
[ -s "${STAGE}/${SNAPSHOT}" ] || { log "빈 Vault snapshot"; exit 1; }
SNAPSHOT_SHA=$(sha256sum "${STAGE}/${SNAPSHOT}" | awk '{print $1}')
printf '%s  %s\n' "${SNAPSHOT_SHA}" "${SNAPSHOT}" >"${STAGE}/${MANIFEST}"

"${RCLONE}" copyto "${STAGE}/${SNAPSHOT}" "local:${BUCKET}/${OBJECT}" "${RCLONE_COMMON[@]}"
"${RCLONE}" copyto "${STAGE}/${MANIFEST}" "local:${BUCKET}/vault/${MANIFEST}" "${RCLONE_COMMON[@]}"
"${RCLONE}" copyto "local:${BUCKET}/${OBJECT}" "${STAGE}/download-${SNAPSHOT}" "${RCLONE_COMMON[@]}"
DOWNLOADED_SHA=$(sha256sum "${STAGE}/download-${SNAPSHOT}" | awk '{print $1}')
[ "${SNAPSHOT_SHA}" = "${DOWNLOADED_SHA}" ] || { log "S3 round-trip SHA-256 불일치"; exit 1; }
log "S3 round-trip 검증 완료 sha256=${SNAPSHOT_SHA}"

mapfile -t SNAPSHOTS < <(
  "${RCLONE}" lsf "local:${BUCKET}/vault" "${RCLONE_COMMON[@]}" --files-only \
    --include 'vault-raft-*.snap' | sort -r
)
for OLD in "${SNAPSHOTS[@]:${RETENTION}}"; do
  [[ "${OLD}" =~ ^vault-raft-[0-9]{8}T[0-9]{6}Z\.snap$ ]] \
    || { log "보존 삭제 대상 형식이 안전하지 않다 name=${OLD}"; exit 1; }
  "${RCLONE}" deletefile "local:${BUCKET}/vault/${OLD}" "${RCLONE_COMMON[@]}"
  "${RCLONE}" deletefile "local:${BUCKET}/vault/${OLD}.sha256" "${RCLONE_COMMON[@]}" || true
  log "보존 세대 초과 object 삭제 name=${OLD}"
done

printf '%s\n' "${OBJECT}" >"${STATE_DIR}/last-object"
printf '%s\n' "${SNAPSHOT_SHA}" >"${STATE_DIR}/last-sha256"
date -u +%s >"${STATE_DIR}/last-success.epoch"
rm -f "${STATE_DIR}/last-failure"
log "Vault Raft snapshot 완료 object=${OBJECT} retained=${RETENTION}"
