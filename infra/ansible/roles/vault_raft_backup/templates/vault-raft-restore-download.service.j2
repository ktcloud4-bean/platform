[Unit]
Description=BKP-03 latest Vault Raft snapshot S3 restore input download
After=network-online.target
Wants=network-online.target
OnFailure=vault-raft-backup-failure@vault-raft-backup.service.service

[Service]
Type=oneshot
User={{ bkp03_backup_user }}
Group={{ bkp03_backup_group }}
UMask=0077
Environment=HOME={{ bkp03_state_dir }}
Environment=XDG_CACHE_HOME={{ bkp03_cache_dir }}
EnvironmentFile={{ bkp03_config_dir }}/s3.env
ExecStart=/usr/local/libexec/vault-raft-restore-download.sh
TimeoutStartSec={{ vault_backup_timeout_sec }}
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths={{ bkp03_config_dir }}
ReadWritePaths={{ bkp03_state_dir }} {{ bkp03_cache_dir }}
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressAllow=localhost
{% for source in bkp03_backup_ip_allow %}
IPAddressAllow={{ source }}
{% endfor %}
IPAddressDeny=any
