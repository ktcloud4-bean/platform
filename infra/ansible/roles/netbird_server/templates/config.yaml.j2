server:
  listenAddress: ':8080'
  exposedAddress: 'https://{{ netbird_domain }}'
  dataDir: '{{ netbird_data_dir }}'
  stunPorts:
    - 3478
  metricsPort: 9090
  healthcheckAddress: ':9000'
  logLevel: 'info'
  logFile: 'console'
  authSecret: '{{ netbird_auth_secret }}'
  auth:
    issuer: 'https://{{ netbird_domain }}/oauth2'
    localAuthDisabled: false
    signKeyRefreshEnabled: true
    dashboardRedirectURIs:
      - 'https://{{ netbird_domain }}/nb-auth'
      - 'https://{{ netbird_domain }}/nb-silent-auth'
    cliRedirectURIs:
      - 'http://localhost:53000/'
    owner:
      email: '{{ netbird_admin_email }}'
      password: '{{ netbird_owner_password }}'
    mfaSessionMaxLifetime: '24h'
    mfaSessionIdleTimeout: '1h'
  store:
    engine: 'sqlite'
    encryptionKey: '{{ netbird_encryption_key }}'
  activityStore:
    engine: 'sqlite'
    file: '{{ netbird_data_dir }}/events.db'
  authStore:
    engine: 'sqlite3'
    file: '{{ netbird_data_dir }}/idp.db'
