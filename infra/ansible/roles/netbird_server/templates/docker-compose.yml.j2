services:
  traefik:
    image: {{ traefik_image }}
    container_name: netbird-traefik
    restart: unless-stopped
    command:
      - "--global.checknewversion=false"
      - "--global.sendanonymoususage=false"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.web.http.redirections.entryPoint.to=websecure"
      - "--entrypoints.web.http.redirections.entryPoint.scheme=https"
      - "--entrypoints.websecure.address=:443"
      - "--entrypoints.websecure.http.tls=true"
      - "--providers.file.filename=/etc/traefik/dynamic.yml"
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--log.level=INFO"
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - "/var/run/docker.sock:/var/run/docker.sock:ro"
      - "{{ netbird_letsencrypt_dir }}:/letsencrypt:ro"
      - "{{ netbird_config_dir }}/traefik-dynamic.yml:/etc/traefik/dynamic.yml:ro"
    networks:
      - netbird-net

  management:
    image: {{ netbird_management_image }}
    container_name: netbird-management
    restart: unless-stopped
    command:
      - "--port"
      - "8080"
      - "--log-file"
      - "console"
      - "--log-level"
      - "info"
      - "--disable-anonymous-metrics=true"
      - "--disable-geolite-update=true"
    volumes:
      - "{{ netbird_data_dir }}:/var/lib/netbird"
      - "{{ netbird_config_dir }}/management.json:/etc/netbird/management.json:ro"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.netbird-api.rule=Host(`{{ netbird_domain }}`) && PathPrefix(`/api`)"
      - "traefik.http.routers.netbird-api.entrypoints=websecure"
      - "traefik.http.routers.netbird-api.service=netbird-api"
      - "traefik.http.routers.netbird-api.tls=true"
      - "traefik.http.services.netbird-api.loadbalancer.server.port=8080"
      - "traefik.http.routers.netbird-management.rule=Host(`{{ netbird_domain }}`) && PathPrefix(`/management.ManagementService/`)"
      - "traefik.http.routers.netbird-management.entrypoints=websecure"
      - "traefik.http.routers.netbird-management.service=netbird-management-grpc"
      - "traefik.http.routers.netbird-management.tls=true"
      - "traefik.http.routers.netbird-management.priority=100"
      - "traefik.http.services.netbird-management-grpc.loadbalancer.server.port=8080"
      - "traefik.http.services.netbird-management-grpc.loadbalancer.server.scheme=h2c"
      - "traefik.http.routers.netbird-wsproxy-management.rule=Host(`{{ netbird_domain }}`) && PathPrefix(`/ws-proxy/management`)"
      - "traefik.http.routers.netbird-wsproxy-management.entrypoints=websecure"
      - "traefik.http.routers.netbird-wsproxy-management.service=netbird-wsproxy-management"
      - "traefik.http.routers.netbird-wsproxy-management.tls=true"
      - "traefik.http.routers.netbird-wsproxy-management.priority=100"
      - "traefik.http.services.netbird-wsproxy-management.loadbalancer.server.port=8080"
    networks:
      - netbird-net

  signal:
    image: {{ netbird_signal_image }}
    container_name: netbird-signal
    restart: unless-stopped
    command: ["run", "--port", "10000", "--log-file", "console", "--log-level", "info"]
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.netbird-signal-grpc.rule=Host(`{{ netbird_domain }}`) && PathPrefix(`/signalexchange.SignalExchange/`)"
      - "traefik.http.routers.netbird-signal-grpc.entrypoints=websecure"
      - "traefik.http.routers.netbird-signal-grpc.service=netbird-signal-grpc"
      - "traefik.http.routers.netbird-signal-grpc.tls=true"
      - "traefik.http.routers.netbird-signal-grpc.priority=100"
      - "traefik.http.services.netbird-signal-grpc.loadbalancer.server.port=10000"
      - "traefik.http.services.netbird-signal-grpc.loadbalancer.server.scheme=h2c"
      - "traefik.http.routers.netbird-signal-ws.rule=Host(`{{ netbird_domain }}`) && PathPrefix(`/ws-proxy/signal`)"
      - "traefik.http.routers.netbird-signal-ws.entrypoints=websecure"
      - "traefik.http.routers.netbird-signal-ws.service=netbird-signal-grpc"
      - "traefik.http.routers.netbird-signal-ws.tls=true"
    networks:
      - netbird-net

  relay:
    image: {{ netbird_relay_image }}
    container_name: netbird-relay
    restart: unless-stopped
    command:
      - "--listen-address=:33080"
      - "--exposed-address=rels://{{ netbird_domain }}:443"
      - "--auth-secret={{ netbird_auth_secret }}"
      - "--enable-stun"
      - "--stun-ports=3478"
      - "--log-file=console"
      - "--log-level=info"
    ports:
      - "3478:3478/udp"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.netbird-relay.rule=Host(`{{ netbird_domain }}`) && Path(`/relay`)"
      - "traefik.http.routers.netbird-relay.entrypoints=websecure"
      - "traefik.http.routers.netbird-relay.service=netbird-relay"
      - "traefik.http.routers.netbird-relay.tls=true"
      - "traefik.http.services.netbird-relay.loadbalancer.server.port=33080"
    networks:
      - netbird-net

  dashboard:
    image: {{ netbird_dashboard_image }}
    container_name: netbird-dashboard
    restart: unless-stopped
    environment:
      - NETBIRD_MGMT_API_ENDPOINT=https://{{ netbird_domain }}
      - NETBIRD_MGMT_GRPC_API_ENDPOINT=https://{{ netbird_domain }}
      - AUTH_AUDIENCE={{ netbird_keycloak_client_id }}
      - AUTH_CLIENT_ID={{ netbird_keycloak_client_id }}
      - AUTH_AUTHORITY={{ netbird_keycloak_issuer }}
      - AUTH_SUPPORTED_SCOPES=openid profile email
      - AUTH_REDIRECT_URI=/nb-auth
      - AUTH_SILENT_REDIRECT_URI=/nb-silent-auth
      - NETBIRD_TOKEN_SOURCE=accessToken
      - USE_AUTH0=false
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.dashboard.rule=Host(`{{ netbird_domain }}`)"
      - "traefik.http.routers.dashboard.entrypoints=websecure"
      - "traefik.http.routers.dashboard.service=dashboard"
      - "traefik.http.routers.dashboard.tls=true"
      - "traefik.http.routers.dashboard.priority=1"
      - "traefik.http.services.dashboard.loadbalancer.server.port=80"
    networks:
      - netbird-net

networks:
  netbird-net:
    driver: bridge
