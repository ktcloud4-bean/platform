[Unit]
Description=BKP-03 PostgreSQL physical base backup to SeaweedFS S3
Documentation=https://www.postgresql.org/docs/16/app-pgbasebackup.html
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
OnFailure=postgres-native-backup-failure@postgres-native-backup.service.service

[Service]
Type=oneshot
User={{ bkp03_backup_user }}
Group={{ bkp03_backup_group }}
UMask=0077
Environment=HOME={{ bkp03_state_dir }}
Environment=XDG_CACHE_HOME={{ bkp03_cache_dir }}
EnvironmentFile={{ bkp03_config_dir }}/s3.env
ExecStart=/usr/local/libexec/postgres-native-backup.sh
TimeoutStartSec={{ postgres_backup_timeout_sec }}
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadOnlyPaths={{ bkp03_config_dir }} {{ postgres_backup_socket_dir }}
ReadWritePaths={{ bkp03_state_dir }} {{ bkp03_cache_dir }}
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressAllow=localhost
{% for source in bkp03_backup_ip_allow %}
IPAddressAllow={{ source }}
{% endfor %}
IPAddressDeny=any
