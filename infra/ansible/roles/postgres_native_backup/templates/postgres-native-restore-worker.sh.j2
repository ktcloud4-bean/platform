#!/bin/bash
set -euo pipefail
umask 077

STATE_DIR={{ bkp03_state_dir }}
CACHE_DIR={{ bkp03_cache_dir }}
CONFIG_DIR={{ bkp03_config_dir }}
RCLONE={{ bkp03_rclone_path }}
BUCKET=${BKP03_S3_BUCKET:?BKP03_S3_BUCKET is required}
RESTORE_PORT={{ postgres_restore_port }}

exec 9>"${STATE_DIR}/restore.lock"
flock -n 9 || { echo "다른 PostgreSQL restore가 실행 중이다" >&2; exit 75; }

read -r OBJECT <"${STATE_DIR}/last-object"
read -r EXPECTED_MARKER_SHA <"${STATE_DIR}/expected-marker.sha256"
[[ "${OBJECT}" =~ ^postgres/postgres-base-[0-9]{8}T[0-9]{6}Z\.tar\.gz$ ]] \
  || { echo "restore object 형식이 안전하지 않다" >&2; exit 1; }
[[ "${EXPECTED_MARKER_SHA}" =~ ^[0-9a-f]{64}$ ]] \
  || { echo "expected marker SHA-256 형식이 잘못됐다" >&2; exit 1; }

STAGE=$(mktemp -d "${CACHE_DIR}/restore.XXXXXX")
SOCKET_DIR="${STAGE}/socket"
PGDATA="${STAGE}/pgdata"
STARTED=0
cleanup() {
  if [ "${STARTED}" -eq 1 ]; then
    /usr/bin/pg_ctl -D "${PGDATA}" -m fast -w stop >/dev/null 2>&1 || true
  fi
  rm -rf -- "${STAGE}"
}
trap cleanup EXIT INT TERM

ARCHIVE=${OBJECT##*/}
RCLONE_COMMON=(
  --config "${CONFIG_DIR}/rclone.conf"
  --ca-cert "{{ bkp03_s3_ca_path }}"
  --retries 3
  --low-level-retries 10
  --log-level NOTICE
)

"${RCLONE}" copyto "local:${BUCKET}/${OBJECT}" "${STAGE}/${ARCHIVE}" "${RCLONE_COMMON[@]}"
"${RCLONE}" copyto "local:${BUCKET}/postgres/${ARCHIVE}.sha256" \
  "${STAGE}/${ARCHIVE}.sha256" "${RCLONE_COMMON[@]}"
(cd "${STAGE}" && sha256sum --check --status "${ARCHIVE}.sha256")
tar -C "${STAGE}" -xzf "${STAGE}/${ARCHIVE}"
chmod 0700 "${PGDATA}"

{
  printf '%s\n' '{{ postgres_backup_peer_map }} {{ bkp03_backup_user }} postgres'
  cat "${PGDATA}/pg_ident.conf"
} >"${STAGE}/pg_ident.conf"
mv "${STAGE}/pg_ident.conf" "${PGDATA}/pg_ident.conf"
{
  printf '%s\n' 'local all postgres peer map={{ postgres_backup_peer_map }}'
  cat "${PGDATA}/pg_hba.conf"
} >"${STAGE}/pg_hba.conf"
mv "${STAGE}/pg_hba.conf" "${PGDATA}/pg_hba.conf"
rm -f "${PGDATA}/postmaster.pid" "${PGDATA}/postmaster.opts"
mkdir -m 0700 "${SOCKET_DIR}"

/usr/bin/pg_ctl -D "${PGDATA}" \
  -o "-p ${RESTORE_PORT} -c listen_addresses='' -c unix_socket_directories='${SOCKET_DIR}' -c logging_collector=off" \
  -l "${STAGE}/postgres.log" -w start
STARTED=1

ACTUAL_MARKER_SHA=$(
  /usr/bin/psql -XAt -h "${SOCKET_DIR}" -p "${RESTORE_PORT}" -U postgres -d verify_db \
    -c 'SELECT marker FROM public.bkp03_restore_marker' | sha256sum | awk '{print $1}'
)
[ "${ACTUAL_MARKER_SHA}" = "${EXPECTED_MARKER_SHA}" ] \
  || { echo "복원 marker SHA-256 불일치" >&2; exit 1; }

KEYCLOAK_ROLE_COUNT=$(
  /usr/bin/psql -XAt -h "${SOCKET_DIR}" -p "${RESTORE_PORT}" -U postgres -d postgres \
    -c "SELECT count(*) FROM pg_roles WHERE rolname='keycloak_user'"
)
[ "${KEYCLOAK_ROLE_COUNT}" = 1 ] || { echo "복원본 keycloak_user 구조가 없다" >&2; exit 1; }

if /usr/sbin/ss -H -lnt | awk -v p=":${RESTORE_PORT}" '$4 ~ p"$" {found=1} END {exit found ? 0 : 1}'; then
  echo "격리 restore가 TCP listener를 열었다" >&2
  exit 1
fi

{
  printf 'object=%s\n' "${OBJECT}"
  printf 'archive_sha256=%s\n' "$(sha256sum "${STAGE}/${ARCHIVE}" | awk '{print $1}')"
  printf 'marker_sha256=%s\n' "${ACTUAL_MARKER_SHA}"
  printf 'keycloak_user_count=%s\n' "${KEYCLOAK_ROLE_COUNT}"
  printf 'tcp_listener_count=0\n'
} >"${STATE_DIR}/last-restore-report"

/usr/bin/pg_ctl -D "${PGDATA}" -m fast -w stop >/dev/null
STARTED=0
printf 'PostgreSQL isolated restore PASS marker_sha256=%s\n' "${ACTUAL_MARKER_SHA}"
