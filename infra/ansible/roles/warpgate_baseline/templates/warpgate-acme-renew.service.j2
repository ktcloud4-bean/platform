{{ ansible_managed | comment }}
[Unit]
Description=Renew the Warpgate DNS-01 certificate
Documentation=https://go-acme.github.io/lego/
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
ExecStart={{ warpgate_lego_binary_path }} run --accept-tos --email {{ warpgate_acme_email }} --server {{ warpgate_acme_server }} --dns cloudflare --dns.propagation.wait {{ warpgate_acme_dns_propagation_wait }} --domains {{ warpgate_external_host }} --path {{ warpgate_acme_dir }} --env-file {{ warpgate_acme_credentials_dir }}/cloudflare.env --renew-days {{ warpgate_acme_renew_days }} --deploy-hook /usr/local/libexec/warpgate-acme-deploy
CapabilityBoundingSet=CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_DAC_OVERRIDE

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{ warpgate_acme_dir }} {{ warpgate_data_dir }}
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
