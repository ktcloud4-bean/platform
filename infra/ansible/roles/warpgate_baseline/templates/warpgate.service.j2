{{ ansible_managed | comment }}
[Unit]
Description=Warpgate privileged session gateway ({{ warpgate_version }})
Documentation=https://github.com/warp-tech/warpgate
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ warpgate_user }}
Group={{ warpgate_group }}
ExecStart={{ warpgate_binary_path }} --config {{ warpgate_config_path }} run
Restart=on-failure
RestartSec=5s
WorkingDirectory={{ warpgate_data_dir }}

# --- systemd hardening ---
# 제품이 요구하는 것: {{ warpgate_data_dir }} 쓰기, TCP listen, /etc/warpgate.yaml 읽기.
# 그 밖의 권한은 모두 제거한다.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{ warpgate_data_dir }}
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
UMask=0077

[Install]
WantedBy=multi-user.target
