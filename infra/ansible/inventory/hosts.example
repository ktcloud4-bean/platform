# hosts.example
# 비밀이 포함되지 않은 예시 인벤토리 파일입니다.
# 실제 실행 시에는 hosts.local 파일(gitignore 대상)을 생성하거나
# -i 옵션으로 대상 host/IP를 전달하세요.
#
# 그룹 이름은 playbooks/ 의 hosts: 와 정확히 같아야 한다. 이름이 어긋나면
# ansible-playbook 은 실패가 아니라 "skipping: no hosts matched" 로 조용히
# 아무것도 하지 않는다. 여기의 그룹 목록은 playbook 전체를 덮어야 한다.

[rocky_baseline]
# example_target ansible_host=10.10.10.199 ansible_user=rocky

[k3s_servers]
# k3s-01 ansible_host=<docs/ip-plan.md의 k3s-01 주소> ansible_user=rocky

[postgres_nodes]
# postgres-01 ansible_host=10.10.50.10 ansible_user=rocky

[warpgate_nodes]
# warpgate-01 ansible_host=10.10.30.10 ansible_user=rocky

[warpgate_ssh_targets]
# WG-03: k3s-01 ansible_host=<docs/ip-plan.md의 k3s-01 주소> ansible_user=rocky
# WG-03: postgres-01 ansible_host=<docs/ip-plan.md의 postgres-01 주소> ansible_user=rocky
# WG-03: object-01 ansible_host=<docs/ip-plan.md의 object-01 주소> ansible_user=rocky
# WG-03: netbird-01 ansible_host=<docs/ip-plan.md의 netbird-01 주소> ansible_user=rocky

[netbird_server]
# netbird-01 ansible_host=<docs/ip-plan.md의 netbird-01 주소> ansible_user=rocky

[object_nodes]
# object-01 ansible_host=<docs/ip-plan.md의 object-01 주소> ansible_user=rocky
# 실제 inventory에서 seaweedfs_s3_allowed_sources에 소비자 /32 CIDR를 선언한다.

[node_exporter_fleet]
# OBS-11: k3s-01은 기존 kube-prometheus-stack DaemonSet(port 9100, hostNetwork)을
# 재사용하므로 이 그룹에서는 제외한다. root filesystem 경보용 별도 target은 아래
# node_exporter_root_k3s01 그룹을 본다.
# node_exporter_listen_address는 각 host/guest의 실제 관리 주소로 명시한다.
# proxmox-01 ansible_host=<docs/ip-plan.md의 proxmox-01 주소> ansible_user=root node_exporter_listen_address=<같은 주소>
# postgres-01 ansible_host=<docs/ip-plan.md의 postgres-01 주소> ansible_user=rocky node_exporter_listen_address=<같은 주소>
# object-01 ansible_host=<docs/ip-plan.md의 object-01 주소> ansible_user=rocky node_exporter_listen_address=<같은 주소>
# warpgate-01 ansible_host=<docs/ip-plan.md의 warpgate-01 주소> ansible_user=rocky node_exporter_listen_address=<같은 주소>
# netbird-01 ansible_host=<docs/ip-plan.md의 netbird-01 주소> ansible_user=rocky node_exporter_listen_address=<같은 주소>

[node_exporter_root_k3s01]
# OBS-13: 기존 DaemonSet(port 9100)은 non-root securityContext(runAsUser 65534)가
# /proc/1/mountinfo를 읽지 못해 filesystem collector만 실패한다(OBS-11이 기존 한계로
# 판정, 확대하지 않음). root/PVC 사용률 경보를 위해 DaemonSet은 그대로 두고 다른
# 포트(9101)에 별도 host-level node_exporter를 하나 더 둔다. ADR-0002대로 이
# 단일 노드 local-path 환경에서는 k3s-01 root filesystem 사용률이 곧 PVC 용량 상한
# 신호다.
# k3s-01 ansible_host=<docs/ip-plan.md의 k3s-01 주소> ansible_user=rocky node_exporter_listen_address=<같은 주소> node_exporter_listen_port=9101

[wazuh_agent_fleet]
# WAZUH-03: 6개 대상에 최소 HIDS(syscheck+rootcheck) agent를 설치한다.
# wazuh_agent_authd_password는 절대 인벤토리에 두지 않고 실행 시 -e로만 준다
# (gitops/tools/wazuh-01/provision.sh가 이미 만든 저장소 밖 authd-password 재사용).
# wazuh_agent_extra_syscheck_directories는 대상별 설정·인증서 경로만 최소로 담는다
# (쉼표로만 구분한 문자열 — INI 인벤토리는 JSON/YAML 리스트 문법을 타입 변환하지
# 않고 그대로 문자열로 남긴다는 것을 실측으로 확인했다. role이 split(',')로 나눈다).
# proxmox-01만 Debian 13 물리 호스트라 ansible_user=root, 나머지 5대는 Rocky 9
# ansible_user=rocky다.
# proxmox-01 ansible_host=<docs/ip-plan.md의 proxmox-01 주소> ansible_user=root wazuh_agent_extra_syscheck_directories=/etc/pve,/etc/network
# k3s-01 ansible_host=<docs/ip-plan.md의 k3s-01 주소> ansible_user=rocky wazuh_agent_extra_syscheck_directories=/etc/rancher/k3s,/var/lib/rancher/k3s/server/tls,/var/lib/rancher/k3s/server/token
# warpgate-01 ansible_host=<docs/ip-plan.md의 warpgate-01 주소> ansible_user=rocky wazuh_agent_extra_syscheck_directories=/etc/warpgate.yaml,/var/lib/warpgate-acme
# netbird-01 ansible_host=<docs/ip-plan.md의 netbird-01 주소> ansible_user=rocky wazuh_agent_extra_syscheck_directories=/etc/netbird
# postgres-01 ansible_host=<docs/ip-plan.md의 postgres-01 주소> ansible_user=rocky wazuh_agent_extra_syscheck_directories=/var/lib/pgsql/data/postgresql.conf,/var/lib/pgsql/data/pg_hba.conf,/var/lib/pgsql/data/server-ca.crt,/var/lib/pgsql/data/server-ca.key,/var/lib/pgsql/data/server.crt,/var/lib/pgsql/data/server.key
# object-01 ansible_host=<docs/ip-plan.md의 object-01 주소> ansible_user=rocky wazuh_agent_extra_syscheck_directories=/etc/seaweedfs
