# Proxmox ACME Cloudflare DNS-01 설정 예시 파일
# 이 파일을 infra/proxmox/acme/.env 로 복사하거나 저장소 루트 .env 에 값을 설정합니다.
# 보안을 위해 반드시 파일 권한을 0600 으로 설정해야 합니다 (chmod 600 .env).

# Proxmox ACME DNS-01 검증용 Cloudflare API 토큰
# 대상 도메인 zone 하나로 범위를 제한하고 Zone.DNS (Edit) 권한이 필요합니다.
CLOUDFLARE_API_TOKEN=your_scoped_cloudflare_api_token_here

# 선택 사항: 필요한 경우 Cloudflare Zone ID 또는 Account ID 설정
# CLOUDFLARE_ZONE_ID=your_zone_id_here
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Let's Encrypt 계정 등록용 운영자 연락처 이메일
PROXMOX_ACME_EMAIL=admin@example.invalid
