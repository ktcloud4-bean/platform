# Proxmox ACME Cloudflare DNS-01 설정 예시 파일
# 이 형식으로 ~/secrets/ktcloud4-bean/proxmox/acme/env 를 만듭니다.
# 보안을 위해 반드시 파일 권한을 0600 으로 설정해야 합니다.
# 다른 경로를 쓰려면 PVE_ACME_ENV_FILE 환경변수로 지정합니다.
# 저장소 안에는 실제 값을 두지 않습니다. 이 파일은 형식 계약만 소유합니다.

# Proxmox ACME DNS-01 검증용 Cloudflare API 토큰
# Proxmox 전용 토큰이어야 하며 OPNsense·k3s Traefik·Warpgate 토큰을 재사용하지 않습니다.
# 대상 도메인 zone 하나로 범위를 제한하고 Zone.DNS (Edit) 권한이 필요합니다.
CLOUDFLARE_API_TOKEN=your_scoped_cloudflare_api_token_here

# 선택 사항: 필요한 경우 Cloudflare Zone ID 또는 Account ID 설정
# CLOUDFLARE_ZONE_ID=your_zone_id_here
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# PROXMOX_ACME_EMAIL 은 두지 않습니다. Let's Encrypt 가 2025-06-04 부로 만료 알림을
# 보내지 않아 이 값은 발급·갱신 동작에 영향이 없고, 비밀도 아니므로 저장소 안
# setup-acme.sh 의 DEFAULT_ACME_EMAIL 이 단일 원본을 소유합니다.
