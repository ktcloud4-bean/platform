// AWS-CI-FIX-02: JCasC pipelineJob가 parameter·source를 소유하고 이 Scripted pipeline은 plan만 실행한다.
def allowedRoots = ['tofu-app-network', 'tofu-app-ecr', 'tofu-account-baseline', 'tofu-app-security']
def targetRoot = params.TARGET_ROOT ?: ''
def gitRevision = params.GIT_REVISION ?: 'main'

if (!allowedRoots.contains(targetRoot)) {
  error("AWS-CI-FIX-02 허용되지 않은 TARGET_ROOT: ${targetRoot}")
}

node('aws-opentofu') {
  try {
    timeout(time: 20, unit: 'MINUTES') {
      stage('Checkout immutable revision') {
        deleteDir()
        checkout([
          $class: 'GitSCM',
          branches: [[name: gitRevision]],
          doGenerateSubmoduleConfigurations: false,
          extensions: [],
          userRemoteConfigs: [[
            credentialsId: 'github-platform-readonly-aws-ci-fix-01',
            url: 'ssh://git@ssh.github.com:443/ktcloud4-bean/platform.git'
          ]]
        ])
        sh 'git rev-parse --verify HEAD >/dev/null'
      }

      stage('OpenTofu fmt gate') {
        container('opentofu') {
          sh "tofu -chdir=infra/aws/${targetRoot} fmt -check -diff"
        }
      }

      stage('Trivy config gate') {
        container('trivy') {
          sh "trivy config --exit-code 1 --severity HIGH,CRITICAL infra/aws/${targetRoot}"
        }
      }

      stage('OpenTofu init validate plan') {
        withCredentials([usernamePassword(
          credentialsId: 'aws-credentials-ci01',
          usernameVariable: 'AWS_ACCESS_KEY_ID',
          passwordVariable: 'AWS_SECRET_ACCESS_KEY'
        )]) {
          container('awscli') {
            sh 'umask 077; AWS_PAGER= aws sts get-caller-identity --query Account --output text > .aws-ci-fix-01-account; chmod 0600 .aws-ci-fix-01-account'
          }
          container('opentofu') {
            sh "gitops/tools/aws-ci-fix-01/run-opentofu.sh ${targetRoot} .aws-ci-fix-01-account"
          }
        }
      }
    }
  } finally {
    deleteDir()
  }
}
