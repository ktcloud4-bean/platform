        <mxCell id="e88" value="복구 direct peer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#546E7A;strokeWidth=2;fontSize=11;fontColor=#546E7A;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;fontFamily=Noto Sans CJK KR;dashed=1;dashPattern=6 5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="netbird01" target="warpgate01"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="legend" value="흐름 범례" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B0BEC5;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#B0BEC5;container=1;collapsible=0;pointerEvents=0;fontFamily=Noto Sans CJK KR;" vertex="1" parent="1"><mxGeometry x="40" y="1560" width="1500" height="262" as="geometry" /></mxCell>
        <mxCell id="lg89" value="" style="rounded=0;html=1;fillColor=#1565C0;strokeColor=none;" vertex="1" parent="legend"><mxGeometry x="20" y="48" width="44" height="6" as="geometry" /></mxCell>
        <mxCell id="lgt90" value="접근" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#1565C0;fontStyle=1;fontFamily=Noto Sans CJK KR;" vertex="1" parent="legend"><mxGeometry x="76" y="40" width="96" height="22" as="geometry" /></mxCell>
        <mxCell id="lgd91" value="사용자 → NetBird overlay(sso 인증면만 Cloudflare) → OPNsense → Traefik → Pomerium → 내부 서비스. HR은 Pomerium → S2S VPN → internal ALB → 세 서비스 → Aurora" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#263238;fontFamily=Noto Sans CJK KR;" vertex="1" parent="legend"><mxGeometry x="180" y="40" width="1290" height="40" as="geometry" /></mxCell>
        <mxCell id="lg92" value="" style="rounded=0;html=1;fillColor=#2E7D32;strokeColor=none;" vertex="1" parent="legend"><mxGeometry x="20" y="92" width="44" height="6" as="geometry" /></mxCell>
        <mxCell id="lgt93" value="공급망" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#2E7D32;fontStyle=1;fontFamily=Noto Sans CJK KR;" vertex="1" parent="legend"><mxGeometry x="76" y="84" width="96" height="22" as="geometry" /></mxCell>
        <mxCell id="lgd94" value="GitHub → Gitea → Jenkins(test · SonarQube · Trivy · Cosign) → Harbor 승격 → ECR 복제 → Argo CD digest 선언 → Kyverno admission" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#263238;fontFamily=Noto Sans CJK KR;" vertex="1" parent="legend"><mxGeometry x="180" y="84" width="1290" height="40" as="geometry" /></mxCell>
        <mxCell id="lg95" value="" style="rounded=0;html=1;fillColor=#E65100;strokeColor=none;" vertex="1" parent="legend"><mxGeometry x="20" y="136" width="44" height="6" as="geometry" /></mxCell>
        <mxCell id="lgt96" value="탐지·대응" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#E65100;fontStyle=1;fontFamily=Noto Sans CJK KR;" vertex="1" parent="legend"><mxGeometry x="76" y="128" width="96" height="22" as="geometry" /></mxCell>
        <mxCell id="lgd97" value="Suricata · CrowdSec · Falco · audit event → Wazuh → Shuffle 보강 → 사람 승인. 자동 차단과 자동 대응은 사용하지 않는다" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#263238;fontFamily=Noto Sans CJK KR;" vertex="1" parent="legend"><mxGeometry x="180" y="128" width="1290" height="40" as="geometry" /></mxCell>
        <mxCell id="lg98" value="" style="rounded=0;html=1;fillColor=#6A1B9A;strokeColor=none;" vertex="1" parent="legend"><mxGeometry x="20" y="180" width="44" height="6" as="geometry" /></mxCell>
        <mxCell id="lgt99" value="백업·복구" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#6A1B9A;fontStyle=1;fontFamily=Noto Sans CJK KR;" vertex="1" parent="legend"><mxGeometry x="76" y="172" width="96" height="22" as="geometry" /></mxCell>
        <mxCell id="lgd100" value="Velero · PostgreSQL · Vault snapshot → SeaweedFS S3 → AWS S3 오프사이트. Vault seal은 AWS KMS, 복귀 경로는 Shamir" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#263238;fontFamily=Noto Sans CJK KR;" vertex="1" parent="legend"><mxGeometry x="180" y="172" width="1290" height="40" as="geometry" /></mxCell>
        <mxCell id="lg101" value="" style="rounded=0;html=1;fillColor=#546E7A;strokeColor=none;" vertex="1" parent="legend"><mxGeometry x="20" y="224" width="44" height="6" as="geometry" /></mxCell>
        <mxCell id="lgt102" value="독립 복구" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#546E7A;fontStyle=1;fontFamily=Noto Sans CJK KR;" vertex="1" parent="legend"><mxGeometry x="76" y="216" width="96" height="22" as="geometry" /></mxCell>
        <mxCell id="lgd103" value="NetBird direct peer → Warpgate 특권 세션. Cloudflare · Pomerium · Keycloak 장애와 분리된 경로" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#263238;fontFamily=Noto Sans CJK KR;" vertex="1" parent="legend"><mxGeometry x="180" y="216" width="1290" height="40" as="geometry" /></mxCell>
        <mxCell id="caveat" value="이 그림이 주장하지 않는 것" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF8F8;strokeColor=#C62828;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#C62828;container=1;collapsible=0;pointerEvents=0;fontFamily=Noto Sans CJK KR;" vertex="1" parent="1"><mxGeometry x="1580" y="1560" width="830" height="262" as="geometry" /></mxCell>
        <mxCell id="caveat_t" value="· 물리 노드 · OPNsense · Proxmox · 단일 k3s server 노드는 &lt;b&gt;허용한 SPOF&lt;/b&gt;다. VM 분리는 장애 도메인을 늘리지 않는다.&lt;br&gt;&lt;br&gt;· 다중 리전 · Multi-AZ · RDS HA · 자동 대응 · 전체 DR 성공을 주장하지 않는다.&lt;br&gt;&lt;br&gt;· Suricata는 alert-only, Shuffle은 read-only 보강까지다. 차단과 대응은 사람이 결정한다.&lt;br&gt;&lt;br&gt;· Pod · 주소 · port · 미적용 계획은 이 그림의 범위가 아니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#263238;fontFamily=Noto Sans CJK KR;" vertex="1" parent="caveat"><mxGeometry x="18" y="38" width="794" height="210" as="geometry" /></mxCell>
        <mxCell id="scope" value="그림의 범위" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F7F9FB;strokeColor=#37474F;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#37474F;container=1;collapsible=0;pointerEvents=0;fontFamily=Noto Sans CJK KR;" vertex="1" parent="1"><mxGeometry x="2450" y="1560" width="810" height="262" as="geometry" /></mxCell>
        <mxCell id="scope_t" value="· 온프레미스 플랫폼이 중심이고 AWS는 HR 대표 워크로드와 오프사이트 착지점이다.&lt;br&gt;&lt;br&gt;· Git 선언(&lt;i&gt;gitops/&lt;/i&gt;, &lt;i&gt;infra/&lt;/i&gt;)과 백로그 &lt;b&gt;DONE&lt;/b&gt; 증거가 있는 요소만 넣었다.&lt;br&gt;&lt;br&gt;· 요소별 근거 대조표는 &lt;i&gt;docs/presentation/README.md&lt;/i&gt;의 source matrix가 소유한다.&lt;br&gt;&lt;br&gt;· 발표 생성 이미지의 구조 검수 기준으로 쓴다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#263238;fontFamily=Noto Sans CJK KR;" vertex="1" parent="scope"><mxGeometry x="18" y="38" width="774" height="210" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
