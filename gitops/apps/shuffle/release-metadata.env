# SOAR-DASH-01. 값은 비밀이 아니며 tag가 아니라 digest가 실제 배포 identity다.
# 공식 Shuffle Helm chart·Kubernetes manifest는 upstream 저장소에 없다(docker-compose.yml만
# 있음). Kubernetes 배포 선언은 이 docker-compose.yml과 shuffle-docs/configuration.md를
# 검토해 직접 파생했다. 확인일 2026-08-04, 최신 stable 태그(2026-07-16 이후 rc만 존재).
SHUFFLE_VERSION=2.2.1
SHUFFLE_TAG=v2.2.1
SHUFFLE_TAG_COMMIT=a106f27312bbb81791a33dfee585a6b8d0ad3289
SHUFFLE_RELEASE_URL=https://github.com/Shuffle/Shuffle/releases/tag/v2.2.1
SHUFFLE_LICENSE=AGPL-3.0

SHUFFLE_BACKEND_IMAGE=ghcr.io/shuffle/shuffle-backend:2.2.1
SHUFFLE_BACKEND_IMAGE_DIGEST=sha256:0cc1775e48b7d94b7f16d0be713aa274ced52be24ad521beaaf58c67023fd2e5

SHUFFLE_FRONTEND_IMAGE=ghcr.io/shuffle/shuffle-frontend:2.2.1
SHUFFLE_FRONTEND_IMAGE_DIGEST=sha256:0561dd421382f70d15cada11a324b40762f0930522fcc1b51edcce9c87cc0f00

# orborus·worker는 SOAR-DASH-01 범위 밖(워크플로 실행 엔진, SOAR-01에서 배포)이지만
# 같은 릴리스로 나중에 고정할 수 있도록 확인해 둔 값이다. 이 앱은 아직 이 두 이미지를
# 참조하지 않는다.
SHUFFLE_ORBORUS_IMAGE=ghcr.io/shuffle/shuffle-orborus:2.2.1
SHUFFLE_ORBORUS_IMAGE_DIGEST=sha256:3519810b3ca4fe568acefdf15ce6f2deba0ae6f0ff6b84412354d59d663dff31
SHUFFLE_WORKER_IMAGE=ghcr.io/shuffle/shuffle-worker:2.2.1
SHUFFLE_WORKER_IMAGE_DIGEST=sha256:9541c1fef2bc8511727610b565adbd0f7c817c53afee2dd9fef6aad8a971ffb1

# SOAR-01 정적 offline-only enrichment app. Python stdlib만 사용하며 이미지 tag가
# 아니라 amd64 Linux manifest digest를 배포 identity로 쓴다.
SOAR01_ENRICHMENT_IMAGE=docker.io/library/python:3.12-alpine
SOAR01_ENRICHMENT_IMAGE_DIGEST=sha256:6d43704baacd1bfbe7c295d7f13079d5d8104ed33568873133f8fc69980419df

# Wazuh indexer(WAZUH-01)와 분리한 SOAR-DASH-01 전용 OpenSearch. index digest(멀티arch)를
# 컨테이너 image 참조에 쓴다; amd64 manifest digest는 k3s-01 노드 아키텍처 확인용으로만 둔다.
OPENSEARCH_IMAGE=opensearchproject/opensearch:3.2.0
OPENSEARCH_IMAGE_INDEX_DIGEST=sha256:23297b8d8545e129dd58c254ed08d786dc552410ba772983ad2af31048d2f04b
OPENSEARCH_IMAGE_AMD64_DIGEST=sha256:eab536fd3e19f208e07b65ac8ee6c4bde9b02cb6f191ace87569f922e14b802a

# Vault Agent init은 기존 플랫폼 고정 image를 재사용한다(gitops/apps/wazuh와 동일).
VAULT_IMAGE=hashicorp/vault:2.0.3
VAULT_IMAGE_INDEX_DIGEST=sha256:a296a888b118615dc01d5f1a6846e6d4a7277946caaed5b447008fff5fe06b54

VAULT_CERT_PEM_SHA256=ad445f95c800712947e8a33863d31385d87a0ad2718acab66b8c7315b920d2b6

# CVE: 2026-08-04 확인 시점 Shuffle/Shuffle GitHub Security Advisories 0건
