<!--
  WAZUH-04 사용자 ruleset. Falco·CrowdSec AppSec 2개 소스를 D30으로 분류한다.
  이 파일이 쓰는 custom rule ID는 `100121`(Falco)·`100122`(CrowdSec)·
  `100123`(DEMO-ONPREM-01 Falco 승인 전달)이고, 나머지 `100124`~`100129`는
  향후 headroom으로 비워 둔다. index 분리 pipeline은
  `100100`~`100109`(A90) 밖의 custom ID를 기본 D30 index로 보낸다
  (`files/3-wazuh-01-index-routing` 참고).

  decoder는 `<rule_dir>`가 아니라 `<decoder_dir>etc/decoders</decoder_dir>`에서만 로드된다
  (라이브 dry-run으로 확인, `files/wazuh-04-decoders.xml` 소유). 이 파일은 rule만 갖는다.

  CrowdSec AppSec 설계 중 라이브로 확인한 결과:
  - `GET /v1/alerts`(rule_name·request_uuid 등 상세 alert 필드)는 machine 권한이 필요해
    bouncer API key로는 401이었다.
  - `GET /v1/decisions`(bouncer key로 접근 가능, Traefik crowdsec 플러그인이 실제 차단에
    쓰는 것과 같은 경로)는 이 배포가 CRS anomaly score만으로 inband 403 차단하고 지속
    decision(IP 차단)을 만들지 않아(`CROWDSEC-FIX-01`의 "decision 0개" 판정과 일치)
    실제 WAF 매치 때도 계속 `null`이었다.
  - 반면 `crowdsec-appsec` Pod 자신의 stdout에는 매치 순간
    `level=info msg="WAF block: anomaly score block: anomaly: 5,  from 10.42.0.5 (10.42.0.249)"`
    같은 logfmt 줄이 실제로 찍힌다(2026-08-12 안전한 기존 test 벡터
    `/crowdsec-01/waf/attack`·UA `masscan`으로 라이브 재현). 그래서 LAPI를 거치지 않고
    이 Pod의 로그를 Falco와 같은 방식으로 직접 tail한다 — 새 credential·NetworkPolicy가
    필요 없다.

  마스킹: Falco는 `output_fields`의 process/파일 경로만 노출하고 syscall raw stream이나
  전체 command line은 원천적으로 poll하지 않는다(Falco 자체 출력 규칙, `FALCO-01` 소유).
  CrowdSec AppSec 로그 줄에는 request header·body·query value가 아예 없고 anomaly score와
  IP만 있어 추가 마스킹이 필요 없다.
-->
<group name="wazuh_d30,ids,waf,runtime,">

  <!-- $(rule)은 라이브 dry-run에서 description 치환이 비어 나왔다(top-level JSON 필드도
       custom JSON_Decoder plugin 조합에서는 stock "json" decoder(K8s audit이 쓰는 것)와
       달리 $(...) 치환이 되지 않는 것으로 보인다 — 값 자체는 data.rule로 계속 검색
       가능). description은 고정 문구로 둔다. -->
  <rule id="100121" level="3">
    <decoded_as>wazuh-04-falco-match</decoded_as>
    <description>WAZUH-04 D30: Falco rule match</description>
    <options>no_full_log</options>
  </rule>

  <!-- decoded_as가 wazuh-04-*가 아니라 aws-eks-authenticator인 이유는
       files/wazuh-04-decoders.xml 머리말 참고 — CrowdSec의 logrus 포맷이 그 stock
       decoder와 겹쳐 실제로 그 이름으로 decode된다. <match>로 진짜 CrowdSec AppSec
       WAF block 줄만 고른다(가상의 실제 EKS authenticator 로그와 섞이지 않는다).
       anomaly score·소스 IP는 구조화 필드가 아니라 full_log 원문에 남는다(이 줄에는
       header·body·query value가 없어 원문을 남겨도 안전하다). -->
  <rule id="100122" level="3">
    <decoded_as>aws-eks-authenticator</decoded_as>
    <match>msg="WAF block: </match>
    <description>WAZUH-04 D30: CrowdSec AppSec WAF block</description>
  </rule>

  <!-- DEMO-ONPREM-01만 SOAR-01의 level>=7 경계로 올린다. CRI prefix가 붙은 Falco
       줄은 부모 100121까지 매치하지만 JSON_Decoder의 dynamic field 값은 비어 있으므로,
       원문을 저장하지 않은 채 분석 시점의 raw line에서 exact namespace·Pod marker만
       PCRE2 lookahead로 판정한다. -->
  <rule id="100123" level="7">
    <if_sid>100121</if_sid>
    <match type="pcre2">(?=.*"k8s\.ns\.name":"demo-onprem")(?=.*"k8s\.pod\.name":"demo-onprem-attacker")</match>
    <description>DEMO-ONPREM-01 interactive shell detection</description>
    <options>no_full_log</options>
  </rule>

</group>
