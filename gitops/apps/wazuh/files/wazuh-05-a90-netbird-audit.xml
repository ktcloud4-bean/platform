<!--
  WAZUH-05 사용자 ruleset. NetBird 1개 소스를 A90으로 분류한다. 분류 키는
  group `wazuh_a90`이고, custom rule ID 범위 `100100`~`100109`(A90) 밖은
  자동으로 기본 D30 index를 쓴다(`files/3-wazuh-01-index-routing` 참고). 이
  파일이 쓰는 ID는 `WAZUH-04`가 남겨 둔 마지막 두 자리 `100108`~`100109`다.

  소스는 `infra/ansible/roles/netbird_audit_relay/files/netbird-audit-relay.py`가
  netbird-01의 events.db를 read-only polling해 만드는 순수 JSON 한 줄이다
  (CRI envelope가 없다 — WAZUH-03 host agent가 파일을 직접 tail한다). 라이브
  wazuh-logtest로 확인한 대로 이 형태는 커스텀 decoder 없이 Wazuh 기본 제공
  decoder `json`이 최상위 키와 `meta.*` 1단계 중첩까지 그대로 필드로 뽑는다
  (`account_id`·`action`·`bucket`·`event_id`·`initiator_id`·`meta.*`·
  `target_id`·`timestamp`). `bucket` 필드로 두 rule을 나눈다 — polling
  스크립트가 activity 코드를 이미 두 그룹(계정·사용자·피어·접근 /
  정책·그룹·setup-key)으로 분류해 써 넣는다.

  마스킹(docs/audit-event-standard.md 6절)은 source(polling 스크립트)에서
  이미 allowlist로 끝났다 — setup key 값·geo/city·이메일·표시명은 애초에 이
  파일에 쓰이지 않는다. `<options>no_full_log</options>`는 다른 다섯
  A90 rule과 같은 이유(원문 중복 저장 방지)로 동일하게 적용한다.
-->
<group name="wazuh_a90,netbird_audit,">

  <rule id="100108" level="3">
    <decoded_as>json</decoded_as>
    <field name="bucket">^account_access$</field>
    <description>NetBird account/user/peer/access: $(action)</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100109" level="5">
    <decoded_as>json</decoded_as>
    <field name="bucket">^policy_setupkey$</field>
    <description>NetBird policy/setup-key 변경: $(action)</description>
    <options>no_full_log</options>
  </rule>

</group>
