<!--
  WAZUH-01 사용자 ruleset. Kubernetes API audit terminal stage record를 A90으로 분류한다.
  분류 키는 group `wazuh_a90`이고, filebeat index routing 계약은 **rule ID 범위 100100~100109**이다.
  filebeat output 조건은 서버측 ingest pipeline 파싱 전에 평가되어 `rule.*` 필드를 볼 수
  없으므로 원문 `message`의 `"id":"10010[0-9]"`로 라우팅한다.
  A90 룰을 추가할 때는 반드시 이 범위 안의 ID를 쓴다. D30은 100120번대, O7 억제는 100130이다.
  docs/audit-event-standard.md의 `Metadata` level·terminal stage 경계를 따르며
  request/response object는 apiserver 정책 단계에서 이미 생성하지 않는다.
-->
<group name="wazuh_a90,k8s_audit,">

  <rule id="100100" level="3">
    <decoded_as>json</decoded_as>
    <field name="kind">^Event$</field>
    <field name="apiVersion">^audit.k8s.io/v1$</field>
    <description>Kubernetes API audit: $(verb) $(objectRef.resource)</description>
    <options>no_full_log</options>
  </rule>

  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <field name="responseStatus.code">^4\d\d$|^5\d\d$</field>
    <description>Kubernetes API audit: $(verb) $(objectRef.resource) 실패 $(responseStatus.code)</description>
    <options>no_full_log</options>
  </rule>

</group>
