<!--
  WAZUH-04 사용자 decoder. rule과 달리 decoder는 `<rule_dir>`(etc/rules)가 아니라
  `<decoder_dir>etc/decoders</decoder_dir>`에서만 로드된다 — 라이브 dry-run
  (`wazuh-logtest`)에서 `<rule_dir>` 파일에 `<decoder>`를 섞어 넣었더니
  "ERROR: Invalid configuration. 'decoder' is not a valid element."로 전체 custom
  ruleset load가 깨지는 것을 확인해 분리했다. `wazuh-04-a90-idp-access.xml`·
  `wazuh-04-d30-waf-runtime.xml`의 rule들은 이 파일이 정의하는 decoder 이름을
  `<decoded_as>`로만 참조한다.

  k8s Pod stdout 5개(Keycloak·Pomerium·Vault·Falco·CrowdSec AppSec)는 containerd CRI
  envelope(`<타임스탬프> <stream> <F|P> <원문>`)가 항상 원문 앞에 붙는다. `<prematch>`를
  `^` 앵커 없이 원문 쪽 고유 marker로만 잡으면 envelope 유무와 무관하게 매치되고,
  `<plugin_decoder>JSON_Decoder</plugin_decoder>`는 라인에서 첫 `{`부터 파싱하므로
  envelope를 별도로 벗겨낼 필요가 없다(라이브 dry-run으로 확인, 아래 각 decoder 주석 참고).
  Warpgate는 host agent가 journald를 직접 읽어 이 envelope가 없다.
-->

<!-- Pomerium: authorize 서비스의 allow/deny 판정만 다룬다. 같은 Pod가 내는 envoy
     http-request 로그(도메인 전체 트래픽)는 이 prematch에 안 걸려 제외된다. -->
<decoder name="wazuh-04-pomerium-authorize">
  <prematch>"service":"authorize"</prematch>
  <plugin_decoder>JSON_Decoder</plugin_decoder>
</decoder>

<!-- Vault: 감사 device가 stdout에 쓰는 request/response record. auth.policy_results가
     있는 record만 골라 다른 Vault 로그(seal·storage 등)와 구분한다. -->
<decoder name="wazuh-04-vault-audit">
  <prematch>"policy_results":{"allowed"</prematch>
  <plugin_decoder>JSON_Decoder</plugin_decoder>
</decoder>

<!-- Keycloak: org.keycloak.events logfmt 텍스트 라인. type="..." 값만 뽑는다. -->
<decoder name="wazuh-04-keycloak-event">
  <prematch>org.keycloak.events</prematch>
</decoder>

<decoder name="wazuh-04-keycloak-event-type">
  <parent>wazuh-04-keycloak-event</parent>
  <regex type="pcre2">type="(\S+)",</regex>
  <order>extra_data</order>
</decoder>

<!-- Warpgate: WAZUH-03 host agent의 journald(_SYSTEMD_UNIT=warpgate.service) 원문에서
     "audit: " 뒤 _type="..." 값만 뽑는다. journald 원문은 "Mon DD HH:MM:SS host
     program[pid]: ..." syslog 꼴이라 wazuh의 syslog pre-decoder가 program_name을 먼저
     뽑는다. program_name 없이 prematch만 쓰면 라이브 dry-run에서 "No decoder matched"였다
     — program_name을 명시해야 이 경로로 들어온다(버전 번호가 붙어 정확한 문자열 대신
     prefix로 매칭). -->
<decoder name="wazuh-04-warpgate-audit">
  <program_name>^warpgate-v</program_name>
  <prematch>: audit: </prematch>
</decoder>

<decoder name="wazuh-04-warpgate-audit-type">
  <parent>wazuh-04-warpgate-audit</parent>
  <regex type="pcre2">_type="(\S+)"</regex>
  <order>extra_data</order>
</decoder>

<!-- Falco: FALCO-01 소유 rule 출력. output_fields가 있는 JSON만 대상으로 한다. -->
<decoder name="wazuh-04-falco-match">
  <prematch>"output_fields":{"</prematch>
  <plugin_decoder>JSON_Decoder</plugin_decoder>
</decoder>

<!-- CrowdSec AppSec: crowdsec-appsec Pod 자신의 "WAF block: ..." 로그(logfmt, JSON 아님).
     LAPI alerts/decisions 대신 이 경로를 쓰는 이유는 wazuh-04-d30-waf-runtime.xml 머리말
     참고.

     별도 custom decoder를 두지 않는다. CrowdSec의 Go logrus 출력(`time="<ISO8601>Z"
     level=info msg="..."`)이 stock decoder `aws-eks-authenticator`
     (ruleset/decoders/0565-*.xml)의 prematch와 완전히 겹치고, 라이브 dry-run으로 세 가지를
     확인했다: (1) stock decoder_dir이 custom decoder_dir보다 먼저 로드돼 top-level에서는
     항상 stock 쪽이 이긴다, (2) 그 stock decoder의 자식으로 걸어도 stock의 기존 자식
     `aws-eks-authenticator-fields`가 같은 자리를 먼저 차지해 내 자식 decoder는 시도조차
     안 된다, (3) decoder 체인은 2단계(top-level + child 1단계)만 허용돼 더 깊이 파고들
     수도 없다("Parent decoder name invalid"). 그래서 rule 쪽에서 `decoded_as=
     aws-eks-authenticator`(실제로는 CrowdSec 줄이 이 이름으로 잡힌다)와 `msg="WAF block:`
     텍스트 매치만으로 판별하고, anomaly score·IP는 구조화 필드 대신 `full_log` 원문으로
     남긴다(이 줄에는 request header·body·query value가 아예 없어 원문을 남겨도 안전하다).
-->

